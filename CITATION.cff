cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "DREAM: A Multi-Criteria Global Selection and Local Competence Framework for Dynamic Combination in Heterogeneous Regression Ensembles"
authors:
  - family-names: "Pimentel de Carvalho"
    given-names: "Halcyon Davys"
    orcid: "https://orcid.org/0000-0001-8933-5912"
